# Fastlane configuration for Trans-Hub iOS (TH-025).
#
# Prerequisites:
#   * Apple Developer account + App Store Connect API key.
#   * Code signing via `match` (recommended) or manual provisioning profiles.
#   * Secrets provided by CI (see ci/deploy.yml):
#       APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID,
#       APP_STORE_CONNECT_KEY_BASE64, MATCH_PASSWORD
#
# Run locally:  bundle exec fastlane beta

default_platform(:ios)

WORKSPACE = "Runner.xcworkspace".freeze
SCHEME = "Runner".freeze

platform :ios do
  desc "Load an App Store Connect API key from base64 env (CI)"
  private_lane :api_key do
    key_b64 = ENV["APP_STORE_CONNECT_KEY_BASE64"]
    next nil if key_b64.nil? || key_b64.empty?

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: key_b64,
      is_key_content_base64: true
    )
  end

  desc "Build the Flutter iOS release (no codesign) for archiving"
  lane :build do
    sh("cd .. && flutter build ios --release --no-codesign")
  end

  desc "Build, sign and upload a build to TestFlight"
  lane :beta do
    key = api_key

    # `match` keeps signing certificates/profiles in sync across machines.
    # Configure a Matchfile (git_url, app_identifier) before enabling.
    sync_code_signing(type: "appstore", readonly: true) if File.exist?("Matchfile")

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Promote the latest TestFlight build to the App Store"
  lane :release do
    key = api_key
    upload_to_app_store(
      api_key: key,
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false
    )
  end
end
