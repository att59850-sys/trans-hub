# Trans-Hub environment template (TH-009).
# Copy to .env.dev / .env.staging / .env.prod and fill in per environment.
# NEVER commit real values — these files are gitignored.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated admin emails for the in-app verification review queue (TH-017).
# Leave empty in production unless you want in-app admin review.
ADMIN_EMAILS=admin@transporthub.app

# Optional integrations
FIREBASE_API_KEY=
SENTRY_DSN=
MAPS_API_KEY=
